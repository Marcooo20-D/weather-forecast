{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANEMOS Public API v1",
  "type": "object",
  "required": [
    "brand",
    "version",
    "generated_at",
    "location_name",
    "days"
  ],
  "properties": {
    "brand": {
      "const": "ANEMOS"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "period_label": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "public_brief": {
      "type": "object"
    }
  }
}